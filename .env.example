DATABASE_URL="postgresql://postgres:postgres@localhost:5432/licenciagov?schema=public"
APP_URL="http://localhost:3000"
AUTH_SECRET="troque-por-um-segredo-longo"
# 32 bytes em hex (AES-256-GCM) — em produção vem do secret manager
DATA_KEY="<64 hex – gerar com: openssl rand -hex 32>"
HASH_PEPPER="troque-me"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
CHROMIUM_PATH="/opt/pw-browsers/chromium-1194/chrome-linux/chrome"
SMTP_URL=""
EMAIL_FROM="LicenciaGov <nao-responda@licenciagov.local>"

# ── Storage S3-compatível (STORAGE_DRIVER="s3") – AWS S3 / R2 / MinIO ──
# Em AWS use a role da task (sem chaves); em MinIO/R2 informe endpoint + chaves.
S3_BUCKET="licenciagov"
S3_REGION="sa-east-1"
S3_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ── Servidor / infraestrutura ──
# PORT="3000"            # porta do servidor standalone (container)
# HOSTNAME="0.0.0.0"     # bind do servidor standalone (container)
# TZ="America/Bahia"
# NEXT_DIST_DIR=".next"  # só para rodar vários `next dev` no mesmo checkout

# ── Testes E2E (Playwright) ──
# E2E_BASE_URL="http://localhost:3000"   # alvo (homolog/prod no dia da PoC); vazio = sobe `next dev`
# E2E_SENHA=""                           # sobrescreve a senha demo nos helpers
# E2E_IGNORE_HTTPS="1"                   # só p/ homolog com certificado provisório
# Endpoint público do S3/MinIO para URLs pré-assinadas usadas pelo navegador (opcional)
S3_PUBLIC_ENDPOINT=""
# "false" para Railway Buckets / Cloudflare R2 (virtual-hosted); padrão: path-style quando S3_ENDPOINT definido
S3_FORCE_PATH_STYLE=""

# ── Backup real (docs/backup.md) – worker (filas backup/restore-test) e botões em /admin/backup ──
# Senha da criptografia AES-256 dos dumps (cofre de segredos!). Vazia = derivada da DATA_KEY (aviso na tela).
BACKUP_PASSPHRASE=""
# Bucket S3-compatível em OUTRO provedor/região (R2, B2, S3…). Vazio = storage da aplicação em backups/ (aviso na tela).
BACKUP_S3_ENDPOINT=""
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
# BACKUP_S3_PREFIX="pg/"
# BACKUP_S3_FORCE_PATH_STYLE="true"      # só MinIO
BACKUP_ALERTA_EMAIL=""
BACKUP_RETENCAO_DIAS="30"
# BACKUP_CRON="15 3 * * *"               # diário (fuso JOBS_TZ, padrão America/Bahia)
# BACKUP_RESTORE_CRON="45 4 1 * *"       # mensal
# BACKUP_RESTORE_DATABASE_URL=""         # banco descartável do teste; vazio = cria/apaga licenciagov_restore_test no mesmo servidor
# BACKUP_RESTORE_TOLERANCIA="0.1"        # diferença aceita nas contagens restaurado × produção
# BACKUP_SCHEMAS="public"

# ── Demonstração ──
# "true" exibe a faixa "Ambiente de demonstração – dados fictícios" e rotula os órgãos da página inicial como de demonstração
DEMO_MODE="false"

# ── Mapas (docs/mapas.md) ──
# Chave do Google Maps Platform (Maps JavaScript API) – OPCIONAL. Lida em tempo de execução pelo servidor
# (/api/v1/mapas/config), não no build. Com chave, os mapas internos ganham as bases "Satélite/Híbrido/Ruas (Google)".
# Restrinja a chave por referenciador HTTP (domínio do sistema) e somente à Maps JavaScript API; há cobrança por carga de mapa.
GOOGLE_MAPS_KEY=""
# UF usada nas camadas estaduais (CAR/SICAR, SIGEF) quando o código IBGE do município não é real (dados de demonstração 99…)
MAPAS_UF_PADRAO="BA"

# ── Agente de denúncias ambientais (docs/agente-denuncias.md) ──
# Tudo é opcional: sem OPENROUTER_API_KEY o assistente funciona como questionário passo a passo (determinístico).
# IA via OpenRouter (API compatível com OpenAI). Modelo principal: entende o texto/fotos (tool calling + visão);
# rápido: redige as perguntas. Custos por organização em /admin/canais (tabela uso_ia).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-5"
OPENROUTER_MODEL_RAPIDO="anthropic/claude-haiku-4.5"
# Transcrição de áudios do WhatsApp (Groq Whisper whisper-large-v3). Sem chave: pede para o cidadão escrever.
GROQ_API_KEY=""
# Evolution API v2 (WhatsApp não oficial) – usada por padrão pelos canais WHATSAPP_EVOLUTION ("Criar instância / QR Code")
EVOLUTION_BASE_URL=""
EVOLUTION_API_KEY=""
# "true" = não chama os provedores de WhatsApp (registra SIMULADA no log) – testes/homologação. E-mail usa sempre lib/email.
CANAIS_ENVIO_SIMULADO="false"
# "true" = processa webhooks no próprio processo web mesmo com o worker no ar
# CANAIS_INLINE="false"
# Ritmo de envio nos provedores não oficiais (ms entre mensagens por instância)
# CANAIS_INTERVALO_MIN_MS="3000"
# CANAIS_INTERVALO_MAX_MS="8000"
# Retenção da caixa bruta de webhooks (dias), limite por contato (msgs/10 min), inatividade até encerrar (h)
# CANAIS_RETENCAO_EVENTOS_DIAS="15"
# AGENTE_LIMITE_MSGS="20"
# AGENTE_INATIVIDADE_H="6"
# Em containers com proxy de saída, o fetch do Node precisa de NODE_USE_ENV_PROXY=1

# Monitoramento por satélite (docs/monitoramento.md) – todos opcionais
# MONITORAMENTO_AREA_MINIMA_HA=1        # área mínima (ha) de alerta NOVO para aviso no sino
# MONITORAMENTO_DETER_MESES=24          # janela do DETER Cerrado
# MONITORAMENTO_PRODES_ANOS=2           # anos PRODES >= ano atual - N
# JOBS_CRON_MONITORAMENTO="30 6 * * *"  # agendamento no worker
# MAPBIOMAS_ALERTA_TOKEN=               # MapBiomas Alerta (conta institucional) – sem token a fonte fica desativada

# ── Cobrança de taxas – Pix/boleto via Asaas (docs/cobranca.md) ──
# A chave do Asaas é configurada POR MUNICÍPIO em /admin/cobranca (cifrada no banco), não aqui.
# "true" = nunca chama o Asaas: Pix/linha digitável fictícios + botão "Simular pagamento" (homologação/E2E).
PAGAMENTOS_SIMULADO="false"
# JOBS_CRON_COBRANCA="0 7 * * *"          # job cobranca-sync do worker (fallback do webhook)
# COBRANCA_SYNC_DESATIVADO="false"
