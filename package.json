{
  "name": "licenciagov",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "seed:base": "tsx prisma/seed/base.ts",
    "seed:demo": "tsx prisma/seed/base.ts && tsx --conditions=react-server prisma/seed/demo.ts",
    "jobs": "tsx jobs/worker.ts",
    "backup": "tsx scripts/backup/executar.ts backup",
    "backup:restore-test": "tsx scripts/backup/executar.ts restore-test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:e2e:poc": "playwright test \"tests/e2e/t(0[1-9]|10)-\"",
    "start:standalone": "node .next/standalone/server.js",
    "docker:build": "docker build -t licenciagov:local --target app . && docker build -t licenciagov-worker:local --target worker .",
    "docker:up": "docker compose up -d --build",
    "openapi:export": "tsx -e \"import {documentoOpenApi} from './lib/openapi'; console.log(JSON.stringify(documentoOpenApi(), null, 2))\"",
    "onboard": "tsx prisma/seed/onboarding.ts",
    "monitoramento:sync": "tsx --conditions=react-server jobs/monitoramento.ts",
    "seed:monitoramento-demo": "tsx --conditions=react-server prisma/seed/monitoramento-demo.ts",
    "seed:demandas-demo": "tsx --conditions=react-server prisma/seed/demandas-demo.ts",
    "seed:riachao-demo": "tsx --conditions=react-server prisma/seed/clientes/riachao-demo.ts",
    "seed:cds-poc": "tsx --conditions=react-server prisma/seed/clientes/cds-poc-demo.ts",
    "test:e2e:poc-cds": "E2E_DATASET=poc-cds playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/client": "^6.19.3",
    "@tmcw/togeojson": "^7.1.2",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.gridlayer.googlemutant": "^0.16.0",
    "lucide-react": "^1.48.0",
    "next": "15.5.26",
    "nodemailer": "^10.0.11",
    "pg-boss": "^12.35.0",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shpjs": "^6.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/base.ts"
  }
}
